{
  "manifest_version": 3,
  "name": "Coda Express Clipper",
  "description": "Save the current tab into a Coda table through the coda-express backend.",
  "version": "0.1.0",
  "icons": {
    "16": "web/icons8-panda-glassmorphism-16.png",
    "32": "web/icons8-panda-glassmorphism-32.png",
    "72": "web/icons8-panda-glassmorphism-72.png",
    "96": "web/icons8-panda-glassmorphism-96.png",
    "120": "web/icons8-panda-glassmorphism-120.png",
    "144": "web/icons8-panda-glassmorphism-144.png",
    "192": "web/icons8-panda-glassmorphism-192.png",
    "512": "web/icons8-panda-glassmorphism-512.png"
  },
  "action": {
    "default_title": "Save to Coda",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "web/icons8-panda-glassmorphism-16.png",
      "32": "web/icons8-panda-glassmorphism-32.png",
      "72": "web/icons8-panda-glassmorphism-72.png",
      "96": "web/icons8-panda-glassmorphism-96.png"
    }
  },
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"]
}
